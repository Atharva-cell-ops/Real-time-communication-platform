# ==============================================================================
# CONNECTX - Environment Variables Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL with fallback to SQLite for local dev)
# PostgreSQL format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/connectx_db?schema=public"

# For zero-dependency local SQLite development, set:
# DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=super_secure_connectx_jwt_secret_key_change_in_production_2026!
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE_BYTES=10485760 # 10MB
UPLOAD_DIR=../uploads

# WebRTC STUN/TURN Configuration (comma-separated or JSON)
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
